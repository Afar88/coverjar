# Copy to .env.local. Everything is optional: without keys the app runs in simulated/offline demo mode.

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-flash-latest

# PayPal sandbox app (https://developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=SANDBOX
# Webhook ID from the PayPal REST app's webhook configuration
PAYPAL_WEBHOOK_ID=
# Set to true only after PayPal enables "Pay with crypto" on your merchant account
# PAYPAL_CRYPTO_ENABLED=false

# Sandbox personal-account email that receives "pay to parent" claim payouts
# DEMO_PARENT_EMAIL=
# Sandbox email that receives "pay to repair shop" claim payouts
# DEMO_REPAIR_SHOP_EMAIL=
