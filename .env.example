# Copy to .env.local. DATABASE_URL or POSTGRES_URL is required for data features; Gemini and PayPal can be omitted for demo mode.

# Paraguas authentication (required for production)
PARAGUAS_SESSION_SECRET=
# Optional legacy/demo-only PIN fallback. New family accounts use a parent password
# and per-teen PINs that are hashed and stored in Neon PostgreSQL.
# PARAGUAS_PARENT_PIN=
# PARAGUAS_TEEN_PIN=

# Neon PostgreSQL (required for Vercel deployment)
DATABASE_URL=

# Vercel Blob private store (required for claim-photo uploads)
BLOB_READ_WRITE_TOKEN=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-flash-latest

# PayPal sandbox app (https://developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_WEBHOOK_ID=
# PAYPAL_CRYPTO_ENABLED=false

# Optional sandbox recipients
# DEMO_PARENT_EMAIL=
# DEMO_REPAIR_SHOP_EMAIL=
